{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "relationship.schema.json",
  "title": "Relationship (edge)",
  "description": "One row per directed edge between two nodes (Document, ReferenceArchitecture, Entity or Source). No relationship may exist without evidence - this schema makes evidence/evidence_type/confidence mandatory, matching the FASE 2 requirement.",
  "type": "object",
  "required": [
    "relationship_id",
    "type",
    "from_id",
    "to_id",
    "source_id",
    "source_url",
    "source_file",
    "source_section",
    "evidence",
    "evidence_type",
    "confidence",
    "repository_commit",
    "extraction_date"
  ],
  "properties": {
    "relationship_id": {
      "type": "string",
      "description": "'rel:<from_id>:<TYPE>:<to_id>:<source_file-hash>' - includes source_file so the same semantic edge asserted in two different documents produces two distinct, individually-sourced rows."
    },
    "type": {
      "type": "string",
      "enum": [
        "PART_OF", "USES", "CONNECTS_TO", "REQUIRES", "DEPENDS_ON",
        "EXPOSES", "CONSUMES_DATA_FROM", "AUTHENTICATES_WITH", "EXTENDS",
        "SUPPORTS_PROTOCOL", "DOCUMENTED_BY", "HAS_SOURCE", "HAS_DIAGRAM",
        "HAS_USE_CASE", "BELONGS_TO_DOMAIN", "MENTIONS"
      ]
    },
    "from_id": { "type": "string", "description": "node_id of the source node." },
    "to_id": { "type": "string", "description": "node_id of the target node." },
    "from_type": { "type": "string" },
    "to_type": { "type": "string" },
    "source_id": { "type": "string" },
    "source_url": { "type": ["string", "null"] },
    "source_file": { "type": "string" },
    "source_section": { "type": ["string", "null"] },
    "evidence": {
      "type": "string",
      "description": "Verbatim quoted text that justifies this specific relationship. Mandatory and non-empty."
    },
    "evidence_type": { "type": "string", "enum": ["explicit", "inferred"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "repository_commit": { "type": "string" },
    "extraction_date": { "type": "string", "format": "date-time" }
  }
}
