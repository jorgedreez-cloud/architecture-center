      <data key="e_source_section">Bring Your Own Agent (Outbound)</data>
      <data key="e_evidence">To ensure secure inbound communication and validate server updates, an Identity Authentication Service (IAS) App2App trust relationship must be established between Joule and the target agent server.</data>
      <data key="e_evidence_type">explicit</data>
