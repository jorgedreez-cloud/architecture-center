    <edge id="rel:doc:17c8c5:MENTIONS:entity:sap-datasphere:322e667369" source="doc:17c8c5" target="entity:sap-datasphere">
      <data key="e_type">MENTIONS</data>
      <data key="e_from_id">doc:17c8c5</data>
      <data key="e_to_id">entity:sap-datasphere</data>
