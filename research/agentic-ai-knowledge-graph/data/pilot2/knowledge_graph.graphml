    <edge id="rel:doc:2c8491:MENTIONS:entity:sap-datasphere:2ada8cd38a" source="doc:2c8491" target="entity:sap-datasphere">
      <data key="e_type">MENTIONS</data>
      <data key="e_from_id">doc:2c8491</data>
