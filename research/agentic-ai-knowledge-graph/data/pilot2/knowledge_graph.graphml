      <data key="e_source_section">Customer value</data>
      <data key="e_evidence">Maximize customer's external cloud platform investment and SAP BTP/Datasphere investment by creating the possibility to use real-time SAP business data directly inside the external machine learning environment.</data>
      <data key="e_evidence_type">explicit</data>
      <data key="e_confidence">0.85</data>
      <data key="e_repository_commit">591ed640fd7889503240d282107995a29b075876</data>
