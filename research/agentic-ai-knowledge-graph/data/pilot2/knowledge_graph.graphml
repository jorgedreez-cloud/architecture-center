      <data key="e_source_file">docs/ref-arch/RA0003/readme.md</data>
      <data key="e_source_section">__introduction__</data>
      <data key="e_evidence">The SAP Federated Machine Learning Python library (FedML) applies the Data Federation architecture of SAP Datasphere for intelligently sourcing SAP and non-SAP data for Machine Learning experiments, run on any Machine Learning platform, thereby removing the need for replication or data movement.</data>
      <data key="e_evidence_type">explicit</data>
      <data key="e_confidence">0.85</data>
      <data key="e_repository_commit">591ed640fd7889503240d282107995a29b075876</data>
      <data key="e_extraction_date">2026-07-15T03:09:16.238251+00:00</data>
    </edge>
